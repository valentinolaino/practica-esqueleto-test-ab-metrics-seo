# Conexión a Postgres. Copiá este archivo a .env.local y completá los valores.
# .env.local está ignorado por git: nunca subas credenciales al repo.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/lab01

# Necesario solo si tu Postgres exige TLS (por ejemplo un servicio hosteado).
# DATABASE_SSL=false

# Origen público, para resolver el canonical absoluto.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
